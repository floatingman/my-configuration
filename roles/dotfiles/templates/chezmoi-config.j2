{#- Pre-seeded chezmoi config, generated by the dotfiles role.
    The dotfiles' .chezmoi.toml.tmpl asks machine-specific questions via
    promptBoolOnce/promptStringOnce, which open /dev/tty and fail under
    Ansible (no TTY). promptOnce functions return a value already present
    in the config data without prompting, so seed dotfiles_config.data
    here before `chezmoi init`. A successful init regenerates this file
    from the template and the values persist.
    Supported data shape: scalars, or one level of nested mappings
    (rendered as [data.<key>] tables). -#}
{% set scalars = dotfiles_config.data | dict2items | rejectattr('value', 'mapping') | list %}
{% set tables = dotfiles_config.data | dict2items | selectattr('value', 'mapping') | list %}
{% if scalars %}[data]
{% for item in scalars %}  {{ item.key }} = {{ item.value | to_json }}
{% endfor %}{% endif %}{% for item in tables %}[data.{{ item.key }}]
{% for entry in item.value | dict2items %}  {{ entry.key }} = {{ entry.value | to_json }}
{% endfor %}{% endfor %}
