#!/bin/sh
# {{ ansible_managed }}
#
# Gate network-share automounts on trusted NetworkManager connections
# (e.g. the home WiFi). Installed by the network_shares role.
#
# NetworkManager runs this on every dispatcher event (up/down/connectivity
# change); each run just re-evaluates current state, so extra events are
# harmless. Run manually as root to (re)apply now:
#   sudo /etc/NetworkManager/dispatcher.d/90-network-shares --apply

TRUSTED_CONNECTIONS='{{ network_shares_config.trusted_connections | join("\n") }}'
AUTOMOUNT_UNITS='{% for share in network_shares_config.shares %}{{ share.path | trim("/") | replace("-", "\\x2d") | replace("/", "-") }}.automount {% endfor %}'
MOUNT_UNITS='{% for share in network_shares_config.shares %}{{ share.path | trim("/") | replace("-", "\\x2d") | replace("/", "-") }}.mount {% endfor %}'
MOUNT_PATHS='{{ network_shares_config.shares | map(attribute="path") | join(" ") }}'

log() { logger -t network-shares "$@"; }

active_connections() {
    nmcli --terse --fields NAME,TYPE connection show --active 2>/dev/null \
        | grep -E ':(802-11-wireless|802-3-ethernet)$' \
        | sed 's/:[^:]*$//'
}

is_trusted() {
    [ -n "$TRUSTED_CONNECTIONS" ] || return 1
    _names=$(active_connections)
    [ -n "$_names" ] || return 1
    _ifs=$IFS
    IFS='
'
    for _name in $_names; do
        for _trusted in $TRUSTED_CONNECTIONS; do
            if [ "$_name" = "$_trusted" ]; then
                IFS=$_ifs
                return 0
            fi
        done
    done
    IFS=$_ifs
    return 1
}

if is_trusted; then
    log "trusted connection active: starting $AUTOMOUNT_UNITS"
    # shellcheck disable=SC2086
    systemctl start $AUTOMOUNT_UNITS
else
    log "no trusted connection: stopping $MOUNT_UNITS"
    # shellcheck disable=SC2086
    systemctl stop $AUTOMOUNT_UNITS 2>/dev/null
    # Stopping a .mount unit unmounts it (ForceUnmount= in the units);
    # fall back to a forced lazy unmount for anything still attached.
    # shellcheck disable=SC2086
    systemctl stop $MOUNT_UNITS 2>/dev/null
    for _path in $MOUNT_PATHS; do
        mountpoint -q "$_path" && umount -f -l "$_path" 2>/dev/null
    done
fi
