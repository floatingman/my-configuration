# {{ ansible_managed }}
[Unit]
Description=Network share {{ item.name }} ({{ item.fstype }})
After=network-online.target
Wants=network-online.target

[Mount]
What={{ item.src }}
Where={{ item.path }}
Type={{ item.fstype }}
Options={{ item.options }}
TimeoutSec=30
ForceUnmount=true
{% if network_shares_mode == 'persistent' %}

[Install]
WantedBy=multi-user.target
{% endif %}
