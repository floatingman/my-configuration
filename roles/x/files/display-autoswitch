#!/bin/sh
# display-autoswitch — root entry point for automatic display switching.
#
# Started by the packaged udev rule 40-monitor-hotplug.rules on every DRM
# change event (monitor plugged/unplugged), by systemd after resume
# (autorandr.service is enabled for sleep.target), and by the lid watcher
# (autorandr-lid-watcher.service) when the laptop lid opens or closes.
#
# It applies the best-matching autorandr profile in every open X11 session
# (existing profiles in ~/.config/autorandr stay the source of truth for
# layout, resolutions and per-output options) and then enforces the lid rule
# on the internal panel (lid closed -> panel off, lid open -> panel back on),
# which also covers the cases where autorandr has no matching profile and
# would otherwise keep the current configuration untouched.
#
# autorandr itself is run per session through display-session-exec rather
# than via `autorandr --batch`: our dispatcher scans /proc the same way but
# tolerates processes exiting mid-scan, while autorandr 1.15's batch
# dispatch dies with a "ProcessLookupError: /proc/<pid>/environ" traceback
# in the journal whenever that race hits.
#
# Deployed by the x role (x_display_autoswitch).

set -u

# Give DRM connector storms time to settle: plugging a dock fires several
# udev change events and the kernel takes a moment to expose all outputs.
sleep 1

/usr/local/bin/display-session-exec /usr/bin/autorandr --change

# Enforce the lid rule even when no profile was (re)loaded above.
/usr/local/bin/display-session-exec /usr/local/bin/display-lid-enforce
