#!/bin/sh
# display-lid-enforce — enforce the laptop lid rule on the internal panel.
#
#   lid closed -> internal panel(s) off
#   lid open   -> internal panel(s) back on (preferred mode; placed right of
#                 the primary external output when one is active)
#
# autorandr already treats a closed lid as "internal panel disconnected"
# while external monitors are attached, but only when a matching saved
# profile exists for that exact connectivity. This script closes the gaps:
# lid closed with no matching profile (panel would stay on) and lid opened
# after a profile that keeps the panel off was applied (panel would stay
# off). It is idempotent and only calls xrandr when something must change.
#
# Runs inside the X11 session (needs DISPLAY/XAUTHORITY):
#   * /etc/xdg/autorandr/postswitch.d/10-lid-enforce — after every profile
#     application, including the `exec_always autorandr --change` line in
#     the i3 config at login;
#   * display-autoswitch via display-session-exec — on monitor hotplug,
#     resume and lid toggles.
#
# Exits 0 silently on desktops (no lid or no internal panel) and outside X.
#
# Deployed by the x role (x_display_autoswitch).

set -u

DRY_RUN=false
[ "${1:-}" = "--dry-run" ] && DRY_RUN=true

# --- lid state (same source autorandr's is_closed_lid reads) ---------------
lid=unknown
if [ -d /proc/acpi/button/lid ]; then
    lid=open
    for state_file in /proc/acpi/button/lid/*/state; do
        if [ -r "$state_file" ] && grep -q close "$state_file"; then
            lid=closed
        fi
    done
fi
[ "$lid" = unknown ] && exit 0

# --- current output layout --------------------------------------------------
# A failed xrandr query (e.g. stale XAUTHORITY) must exit nonzero so that
# display-session-exec tries the next session candidate instead of treating
# an empty layout as "nothing to do".
xrandr_output=$(xrandr --query 2>/dev/null) || {
    echo "display-lid-enforce: xrandr query failed on display ${DISPLAY:-unknown}" >&2
    exit 1
}
# One line per connected output:
# "<name> <active 0|1> <internal 0|1> <right-edge px>".
# An output is active when its xrandr status line carries a geometry
# ("1920x1080+0+0"); connected-but-disabled outputs have none. The right
# edge (x + width) is 0 for inactive outputs.
layout=$(printf '%s\n' "$xrandr_output" | awk '
    $2 == "connected" {
        internal = ($1 ~ /^(eDP|LVDS)/) ? 1 : 0
        right = 0
        if (match($0, /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/)) {
            split(substr($0, RSTART, RLENGTH), g, /[x+]/)
            right = g[3] + g[1]
        }
        active = (right > 0) ? 1 : 0
        print $1, active, internal, right
    }')
[ -n "$layout" ] || exit 0

max_right=0
internals_on=""
internals_off=""
while read -r name active internal right; do
    if [ "$internal" = 1 ]; then
        if [ "$active" = 1 ]; then
            internals_on="$internals_on $name"
        else
            internals_off="$internals_off $name"
        fi
    else
        if [ "$active" = 1 ] && [ "$right" -gt "$max_right" ]; then
            max_right=$right
        fi
    fi
done <<EOF
$layout
EOF

failed=0
apply() {
    if [ "$DRY_RUN" = true ]; then
        echo "display-lid-enforce: (dry-run) $*"
    else
        echo "display-lid-enforce: $*"
        # A failed mode change must exit nonzero so display-session-exec
        # retries the next session candidate instead of treating failed
        # lid enforcement as success (same contract as the query above).
        xrandr "$@" || failed=1
    fi
}

if [ "$lid" = closed ]; then
    for panel in $internals_on; do
        apply --output "$panel" --off
    done
else
    # Lid open: place the panel beyond the rightmost edge of ALL active
    # external outputs (--right-of <primary> alone can land on top of a
    # second monitor to the right of the primary). A saved profile that
    # places the panel explicitly wins, because then it is already on.
    for panel in $internals_off; do
        if [ "$max_right" -gt 0 ]; then
            apply --output "$panel" --auto --pos "${max_right}x0"
        else
            apply --output "$panel" --auto --primary
        fi
    done
fi

# Nonzero when any panel mode change failed, so callers (the dispatcher's
# candidate failover, the systemd service) see the failure.
exit "$failed"
